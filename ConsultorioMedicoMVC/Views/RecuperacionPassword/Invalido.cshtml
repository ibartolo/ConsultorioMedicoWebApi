@{
    ViewBag.Title = "Enlace inválido";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
    var message = ViewBag.Message as string ?? "El enlace es inválido o ha expirado.";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="doc-card" style="max-width: 520px; margin: 0 auto; text-align: center;">
    <div class="mb-3">
        <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: #e74a3b;"></i>
    </div>
    <h1>Enlace inválido</h1>
    <p class="doc-meta">@message</p>
    <p>El enlace de recuperación es de un solo uso y caduca a los 10 minutos. Solicite uno nuevo desde la página de inicio de sesión.</p>
    <a href="@Url.Action("Autentication", "Home")" class="btn btn-primary">
        <i class="fas fa-sign-in-alt me-1"></i>Ir a iniciar sesión
    </a>
</div>
