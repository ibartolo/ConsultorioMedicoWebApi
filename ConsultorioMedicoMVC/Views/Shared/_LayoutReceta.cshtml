@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/receta.css")?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/receta.css")).Ticks" rel="stylesheet" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #1a1a1a;
            background: #eef1f5;
        }

        .receta-acciones {
            max-width: 800px;
            margin: 24px auto 0;
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        .btn-imprimir,
        .btn-volver {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 8px;
            border: 1px solid #0099CC;
            background: #0099CC;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-volver {
            background: #fff;
            color: #0099CC;
        }

        @@media print {
            html, body {
                background: #fff;
            }

            .no-print {
                display: none !important;
            }
        }

        @@page {
            size: letter;
            margin: 1.5cm;
        }
    </style>
</head>
<body>
    <div class="receta-acciones no-print">
        <button type="button" class="btn-imprimir" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimir
        </button>
        <a href="@Url.Action("Index", "Consulta")" class="btn-volver">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    @RenderBody()
</body>
</html>
