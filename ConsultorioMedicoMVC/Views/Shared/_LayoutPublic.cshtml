@{
    Layout = null;
    var tema = Request.Cookies["tema"] != null ? Request.Cookies["tema"].Value : "claro";
    if (tema != "claro" && tema != "oscuro") { tema = "claro"; }
    var bsTheme = tema == "oscuro" ? "dark" : "light";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="@bsTheme">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Consultorio Médico</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #00CCFF;
            --primary-dark: #0099CC;
            --dark: #1c2a4a;
            --gray: #6c757d;
        }

        * { box-sizing: border-box; }

        body {
            background: #f0f2f5;
            color: #2b2f38;
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0;
        }

        .doc-header {
            background: linear-gradient(135deg, #00CCFF 0%, #0099CC 100%);
            color: #fff;
            padding: 14px 0;
        }

        .doc-header a {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.05rem;
        }

        .doc-header .sub {
            display: block;
            font-size: .8rem;
            font-weight: 400;
            opacity: .9;
        }

        .doc-wrap {
            max-width: 920px;
            margin: 0 auto;
            padding: 22px 16px 40px;
        }

        .doc-card {
            background: #fff;
            border: 1px solid #e3e6f0;
            border-radius: 10px;
            padding: 30px 34px;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        .doc-card h1 {
            font-size: 1.55rem;
            color: var(--primary-dark);
            margin: 0 0 .25rem;
        }

        .doc-card .doc-meta {
            color: var(--gray);
            font-size: .85rem;
            margin-bottom: 1.2rem;
        }

        .doc-card h2 {
            font-size: 1.1rem;
            color: var(--dark);
            margin: 1.7rem 0 .6rem;
            border-left: 4px solid var(--primary);
            padding-left: 10px;
        }

        .doc-card h3 {
            font-size: 1rem;
            color: var(--dark);
            margin: 1.1rem 0 .4rem;
        }

        .doc-card p,
        .doc-card li {
            font-size: .95rem;
            line-height: 1.6;
        }

        .doc-card ul {
            margin: .4rem 0 .8rem 1.1rem;
        }

        .doc-card .nota {
            background: #e6f9ff;
            border-left: 4px solid var(--primary);
            padding: 10px 14px;
            border-radius: 4px;
            margin: 1rem 0;
            font-size: .92rem;
        }

        .doc-card strong {
            color: var(--dark);
        }

        .doc-footer {
            text-align: center;
            color: var(--gray);
            font-size: .85rem;
            padding: 18px 12px 34px;
        }

        .doc-footer a {
            color: var(--primary-dark);
            text-decoration: none;
        }

        .doc-footer a:hover {
            text-decoration: underline;
        }

        .doc-footer .brand {
            margin-top: 6px;
            font-size: .8rem;
        }

        html[data-bs-theme="dark"] body {
            background: #121212;
            color: #e9ecef;
        }

        html[data-bs-theme="dark"] .doc-card {
            background: #1e1e1e;
            border-color: #343a40;
        }

        html[data-bs-theme="dark"] .doc-card h1 { color: #66DDFF; }
        html[data-bs-theme="dark"] .doc-card h2 { color: #e9ecef; border-left-color: #66DDFF; }
        html[data-bs-theme="dark"] .doc-card h3 { color: #e9ecef; }
        html[data-bs-theme="dark"] .doc-card .doc-meta,
        html[data-bs-theme="dark"] .doc-footer { color: #adb5bd; }
        html[data-bs-theme="dark"] .doc-card .nota { background: #0b3b4a; color: #e9ecef; }
        html[data-bs-theme="dark"] .doc-card strong { color: #e9ecef; }
        html[data-bs-theme="dark"] .doc-footer a { color: #66DDFF; }

        @@media (max-width: 576px) {
            .doc-card { padding: 20px 18px; }
        }
    </style>
</head>
<body>
    <header class="doc-header">
        <div class="doc-wrap" style="padding-top:0;padding-bottom:0;">
            <a href="@Url.Action("Autentication", "Home")">
                <i class="fas fa-stethoscope me-2"></i>Consultorio Médico
                <span class="sub">Desarrollo de Software Inteligente (DESI)</span>
            </a>
        </div>
    </header>

    <main class="doc-wrap">
        @RenderBody()
    </main>

    <footer class="doc-footer">
        <div>
            <a href="@Url.Action("Terminos", "Home")">Términos y Condiciones</a> &middot;
            <a href="@Url.Action("Privacidad", "Home")">Aviso de Privacidad</a> &middot;
            <a href="@Url.Action("Autentication", "Home")">Iniciar sesión</a>
        </div>
        <div class="brand">&copy; @DateTime.Now.Year Consultorio Médico · Desarrollo de Software Inteligente (DESI)</div>
    </footer>
</body>
</html>
