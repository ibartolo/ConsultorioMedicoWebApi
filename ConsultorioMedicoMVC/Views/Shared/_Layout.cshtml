@using ConsultorioMedicoMVC.Helpers
@{
    var sessionUser = SessionHelper.GetSessionUser();
    var userName = (sessionUser != null && sessionUser.UserName != null) ? sessionUser.UserName : "";
    var avatar = userName.Length >= 2 ? userName.Substring(0, 2).ToUpper() : "?";

    var tema = Request.Cookies["tema"] != null ? Request.Cookies["tema"].Value : "claro";
    if (tema != "claro" && tema != "oscuro") { tema = "claro"; }
    var bsTheme = tema == "oscuro" ? "dark" : "light";

    var controllerActual = ViewContext.RouteData.Values["controller"] as string ?? "";
    var actionActual = ViewContext.RouteData.Values["action"] as string ?? "";
    var esDashboard = controllerActual == "Home" && actionActual == "Index";
    var catalogosAbierto = controllerActual == "Tratamiento" || controllerActual == "Paquete";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="@bsTheme">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Consultorio Médico</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/site.css")?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/site.css")).Ticks" rel="stylesheet" />
    <link href="@Url.Content("~/Content/receta.css")?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/receta.css")).Ticks" rel="stylesheet" />
</head>
<body>
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h3>Consultorio Médico</h3>
            <p>Sistema de Administración de Consultorio</p>
        </div>
        <ul class="components">
            <li class="@(esDashboard ? "active" : "")">
                <a href="@Url.Action("Index", "Home")" class="@(esDashboard ? "active" : "")">
                    <i class="fas fa-tachometer-alt"></i>
                    <span class="menu-text">Dashboard</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "Paciente")">
                    <i class="fas fa-user-injured"></i>
                    <span class="menu-text">Pacientes</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "Cita")">
                    <i class="fas fa-calendar-check"></i>
                    <span class="menu-text">Citas</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "Consulta")">
                    <i class="fas fa-stethoscope"></i>
                    <span class="menu-text">Consultas</span>
                </a>
            </li>
            <li class="has-arrow @(catalogosAbierto ? "active" : "")">
                <a href="#">
                    <i class="fas fa-tags"></i>
                    <span class="menu-text">Catálogos</span>
                </a>
                <ul>
                    <li>
                        <a href="@Url.Action("Index", "Tratamiento")" class="@(controllerActual == "Tratamiento" ? "active" : "")">
                            <i class="fas fa-pills"></i>
                            <span class="menu-text">Tratamientos</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Paquete")" class="@(controllerActual == "Paquete" ? "active" : "")">
                            <i class="fas fa-box"></i>
                            <span class="menu-text">Paquetes</span>
                        </a>
                    </li>
                </ul>
            </li>
            <li>
                <a href="@Url.Action("Index", "Usuario")">
                    <i class="fas fa-users"></i>
                    <span class="menu-text">Usuarios</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "DatosInstitucion")">
                    <i class="fas fa-hospital"></i>
                    <span class="menu-text">Datos Institución</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("Index", "DatosFiscales")">
                    <i class="fas fa-file-invoice"></i>
                    <span class="menu-text">Datos Fiscales</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="main-content" id="mainContent">
        <nav class="navbar-top">
            <div style="display: flex; align-items: center; gap: 15px;">
                <button type="button" id="sidebarCollapse" class="menu-toggle">
                    <i class="fas fa-bars"></i>
                </button>
                <span style="color: var(--primary-dark); font-weight: 600; font-size: 1.1rem;">
                    <i class="fas fa-hospital-alt" style="color: var(--primary);"></i> Consultorio Médico
                </span>
            </div>

            <div class="user-menu">
                <div class="user-details">
                    <div class="user-name">@userName</div>
                    <div class="user-role">Usuario</div>
                </div>
                <div class="user-avatar">@avatar</div>
                <div class="dropdown">
                    <button class="btn btn-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" style="border-radius: 50px; padding: 8px 12px; border-color: var(--primary);">
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2" style="color: var(--primary);"></i> Perfil</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("Index", "Configuracion")"><i class="fas fa-cog me-2" style="color: var(--primary);"></i> Configuración</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("Manual", "Home")"><i class="fas fa-book me-2" style="color: var(--primary);"></i> Manual de usuario</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="@Url.Action("Terminos", "Home")" target="_blank"><i class="fas fa-file-contract me-2" style="color: var(--primary);"></i> Términos y Condiciones</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("Privacidad", "Home")" target="_blank"><i class="fas fa-shield-alt me-2" style="color: var(--primary);"></i> Aviso de Privacidad</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" onclick="confirmarCierre()"><i class="fas fa-sign-out-alt me-2" style="color: var(--danger);"></i> Cerrar Sesión</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="page-content">
            @RenderBody()
        </div>

        <footer class="app-footer">
            <div class="app-footer-inner">
                <span>&copy; @DateTime.Now.Year Consultorio Médico. Todos los derechos reservados.</span>
                <span class="app-footer-sep">&middot;</span>
                <a href="@Url.Action("Manual", "Home")">Manual</a>
                <a href="@Url.Action("Terminos", "Home")" target="_blank">Términos</a>
                <a href="@Url.Action("Privacidad", "Home")" target="_blank">Privacidad</a>
                <span class="app-footer-sep">&middot;</span>
                <span>By <a href="https://desipr.com.mx" target="_blank" rel="noopener noreferrer">DESI</a></span>
            </div>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            $('#sidebarCollapse').on('click', function() {
                $('#sidebar').toggleClass('active');
                $('#mainContent').toggleClass('active');
            });

            $('.components li.has-arrow > a').on('click', function (e) {
                e.preventDefault();
                $(this).parent().toggleClass('active');
            });

            window.confirmarCierre = function() {
                Swal.fire({
                    title: '¿Cerrar sesión?',
                    text: '¿Estás seguro de que deseas cerrar sesión?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#0099CC',
                    cancelButtonColor: '#858796',
                    confirmButtonText: 'Sí, cerrar sesión',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("LogOut", "Home")';
                    }
                });
            };
        });

        $(window).on('resize', function() {
            if ($(window).width() > 992) {
                $('#sidebar').removeClass('active');
                $('#mainContent').removeClass('active');
            }
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
