@model ConsultorioMedicoEntities.Catalogos.Paciente

<form id="pacienteForm" autocomplete="off" novalidate>
    <input type="hidden" name="Id" id="Id" value="@Model.Id" />
    <input type="hidden" name="Estatus" id="Estatus" value="@(Model.Estatus ? "true" : "false")" />
    <input type="hidden" name="FechaAlta" id="FechaAlta" value="@(Model.FechaAlta.HasValue ? Model.FechaAlta.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")" />
    <input type="hidden" name="CreatedBY" id="CreatedBY" value="@Model.CreatedBY" />
    <input type="hidden" name="CreatedDT" id="CreatedDT" value="@(Model.CreatedDT.HasValue ? Model.CreatedDT.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")" />
    <input type="hidden" name="UpdatedBY" id="UpdatedBY" value="@Model.UpdatedBY" />
    <input type="hidden" name="UpdatedDT" id="UpdatedDT" value="@(Model.UpdatedDT.HasValue ? Model.UpdatedDT.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")" />
    <input type="hidden" name="Edad" id="Edad" value="@Model.Edad" />

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" for="Nombre">Nombre <span class="required">*</span></label>
            <input type="text" class="form-control" name="Nombre" id="Nombre" value="@Model.Nombre" placeholder="Ingrese el nombre">
        </div>
        <div class="col-md-4">
            <label class="form-label" for="ApellidoPaterno">Apellido Paterno <span class="required">*</span></label>
            <input type="text" class="form-control" name="ApellidoPaterno" id="ApellidoPaterno" value="@Model.ApellidoPaterno" placeholder="Ingrese el apellido paterno">
        </div>
        <div class="col-md-4">
            <label class="form-label" for="ApellidoMaterno">Apellido Materno</label>
            <input type="text" class="form-control" name="ApellidoMaterno" id="ApellidoMaterno" value="@Model.ApellidoMaterno" placeholder="Ingrese el apellido materno">
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-3">
            <label class="form-label" for="Sexo">Sexo <span class="required">*</span></label>
            <select class="form-select" name="Sexo" id="Sexo">
                <option value="">Seleccione...</option>
                <option value="Masculino" @(Model.Sexo == "Masculino" ? "selected" : "")>Masculino</option>
                <option value="Femenino" @(Model.Sexo == "Femenino" ? "selected" : "")>Femenino</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="FechaNacimiento">Fecha de Nacimiento</label>
            <input type="date" class="form-control" name="FechaNacimiento" id="FechaNacimiento" value="@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToString("yyyy-MM-dd") : "")">
        </div>
        <div class="col-md-3">
            <label class="form-label" for="TelefonoCel">Teléfono <span class="required">*</span></label>
            <input type="tel" class="form-control" name="TelefonoCel" id="TelefonoCel" value="@Model.TelefonoCel" placeholder="10 dígitos, ej: 5512345678">
        </div>
        <div class="col-md-3">
            <label class="form-label" for="Email">Correo Electrónico</label>
            <input type="email" class="form-control" name="Email" id="Email" value="@Model.Email" placeholder="Ingrese el correo">
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-12">
            <label class="form-label" for="Comentarios">Comentarios</label>
            <textarea class="form-control" name="Comentarios" id="Comentarios" rows="3" placeholder="Observaciones del paciente...">@Model.Comentarios</textarea>
        </div>
    </div>
</form>
