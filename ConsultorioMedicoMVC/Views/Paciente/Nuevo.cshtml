@model ConsultorioMedicoEntities.Catalogos.Paciente
@{
    ViewBag.Title = Model.Id > 0 ? "Editar Paciente" : "Nuevo Paciente";
}
<h2 class="page-title"><i class="fas fa-user-plus me-2" style="color: var(--primary);"></i>@ViewBag.Title</h2>

<div class="card-custom">
    <div class="card-title"><i class="fas fa-user-plus"></i> Datos del Paciente</div>

    <form id="pacienteForm" autocomplete="off">
        <input type="hidden" id="Id" value="@Model.Id" />
        <input type="hidden" id="Estatus" value="@(Model.Estatus ? "true" : "false")" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Nombre <span class="required">*</span></label>
                <input type="text" class="form-control" id="Nombre" value="@Model.Nombre" placeholder="Ingrese el nombre" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Apellido Paterno</label>
                <input type="text" class="form-control" id="ApellidoPaterno" value="@Model.ApellidoPaterno" placeholder="Ingrese el apellido paterno">
            </div>
            <div class="col-md-4">
                <label class="form-label">Apellido Materno</label>
                <input type="text" class="form-control" id="ApellidoMaterno" value="@Model.ApellidoMaterno" placeholder="Ingrese el apellido materno">
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-3">
                <label class="form-label">Sexo</label>
                <select class="form-select" id="Sexo">
                    <option value="">Seleccione...</option>
                    <option value="Masculino" @(Model.Sexo == "Masculino" ? "selected" : "")>Masculino</option>
                    <option value="Femenino" @(Model.Sexo == "Femenino" ? "selected" : "")>Femenino</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha de Nacimiento</label>
                <input type="date" class="form-control" id="FechaNacimiento" value="@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToString("yyyy-MM-dd") : "")">
            </div>
            <div class="col-md-3">
                <label class="form-label">Teléfono</label>
                <input type="tel" class="form-control" id="TelefonoCel" value="@Model.TelefonoCel" placeholder="Ej: 55 1234 5678">
            </div>
            <div class="col-md-3">
                <label class="form-label">Correo Electrónico</label>
                <input type="email" class="form-control" id="Email" value="@Model.Email" placeholder="Ingrese el correo">
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-12">
                <label class="form-label">Comentarios</label>
                <textarea class="form-control" id="Comentarios" rows="3" placeholder="Observaciones del paciente...">@Model.Comentarios</textarea>
            </div>
        </div>

        <div class="row g-3 mt-3">
            <div class="col-12 text-end">
                <a href="@Url.Action("Index", "Paciente")" class="btn btn-secondary"><i class="fas fa-times me-1"></i> Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Guardar Paciente</button>
            </div>
        </div>
    </form>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var guardarUrl = '@Url.Action("GuardarOActualizarPaciente", "Paciente")';
            var indexUrl = '@Url.Action("Index", "Paciente")';

            $('#pacienteForm').on('submit', function (e) {
                e.preventDefault();

                if (!$('#Nombre').val()) {
                    Swal.fire({ title: 'Atención', text: 'El nombre es requerido.', icon: 'warning', confirmButtonColor: '#0099CC' });
                    return;
                }

                $.ajax({
                    url: guardarUrl,
                    type: 'POST',
                    data: {
                        Id: parseInt($('#Id').val()) || 0,
                        Nombre: $('#Nombre').val(),
                        ApellidoPaterno: $('#ApellidoPaterno').val(),
                        ApellidoMaterno: $('#ApellidoMaterno').val(),
                        Sexo: $('#Sexo').val(),
                        FechaNacimiento: $('#FechaNacimiento').val(),
                        TelefonoCel: $('#TelefonoCel').val(),
                        Email: $('#Email').val(),
                        Comentarios: $('#Comentarios').val(),
                        Estatus: $('#Estatus').val()
                    },
                    dataType: 'text',
                    success: function (response) {
                        var result = (typeof response === 'string') ? JSON.parse(response) : response;
                        if (result.IsSuccess) {
                            Swal.fire({
                                title: '¡Paciente guardado!',
                                text: result.Message || 'El paciente se guardó correctamente.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false,
                                confirmButtonColor: '#0099CC'
                            }).then(function () {
                                window.location.href = indexUrl;
                            });
                        } else {
                            Swal.fire({ title: 'Error', text: result.Message || 'No fue posible guardar el paciente.', icon: 'error', confirmButtonColor: '#0099CC' });
                        }
                    },
                    error: function () {
                        Swal.fire({ title: 'Error', text: 'Error de conexión. Intente nuevamente.', icon: 'error', confirmButtonColor: '#0099CC' });
                    }
                });
            });
        });
    </script>
}
