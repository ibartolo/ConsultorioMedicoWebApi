@model ConsultorioMedicoEntities.Catalogos.Paciente
@{
    ViewBag.Title = Model.Id > 0 ? "Editar Paciente" : "Nuevo Paciente";
}
<h2 class="page-title"><i class="fas fa-user-plus me-2" style="color: var(--primary);"></i>@ViewBag.Title</h2>

<div class="card-custom">
    <div class="card-title"><i class="fas fa-user-plus"></i> Datos del Paciente</div>

    <form id="pacienteForm" autocomplete="off" novalidate>
        <input type="hidden" name="Id" id="Id" value="@Model.Id" />
        <input type="hidden" name="Estatus" id="Estatus" value="@(Model.Estatus ? "true" : "false")" />
        <input type="hidden" name="FechaAlta" id="FechaAlta" value="@(Model.FechaAlta.HasValue ? Model.FechaAlta.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")" />
        <input type="hidden" name="CreatedBY" id="CreatedBY" value="@Model.CreatedBY" />
        <input type="hidden" name="CreatedDT" id="CreatedDT" value="@(Model.CreatedDT.HasValue ? Model.CreatedDT.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")" />
        <input type="hidden" name="UpdatedBY" id="UpdatedBY" value="@Model.UpdatedBY" />
        <input type="hidden" name="UpdatedDT" id="UpdatedDT" value="@(Model.UpdatedDT.HasValue ? Model.UpdatedDT.Value.ToString("yyyy-MM-dd HH:mm:ss") : "")" />
        <input type="hidden" name="Edad" id="Edad" value="@Model.Edad" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="Nombre">Nombre <span class="required">*</span></label>
                <input type="text" class="form-control" name="Nombre" id="Nombre" value="@Model.Nombre" placeholder="Ingrese el nombre">
            </div>
            <div class="col-md-4">
                <label class="form-label" for="ApellidoPaterno">Apellido Paterno <span class="required">*</span></label>
                <input type="text" class="form-control" name="ApellidoPaterno" id="ApellidoPaterno" value="@Model.ApellidoPaterno" placeholder="Ingrese el apellido paterno">
            </div>
            <div class="col-md-4">
                <label class="form-label" for="ApellidoMaterno">Apellido Materno</label>
                <input type="text" class="form-control" name="ApellidoMaterno" id="ApellidoMaterno" value="@Model.ApellidoMaterno" placeholder="Ingrese el apellido materno">
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-3">
                <label class="form-label" for="Sexo">Sexo <span class="required">*</span></label>
                <select class="form-select" name="Sexo" id="Sexo">
                    <option value="">Seleccione...</option>
                    <option value="Masculino" @(Model.Sexo == "Masculino" ? "selected" : "")>Masculino</option>
                    <option value="Femenino" @(Model.Sexo == "Femenino" ? "selected" : "")>Femenino</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="FechaNacimiento">Fecha de Nacimiento</label>
                <input type="date" class="form-control" name="FechaNacimiento" id="FechaNacimiento" value="@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToString("yyyy-MM-dd") : "")">
            </div>
            <div class="col-md-3">
                <label class="form-label" for="TelefonoCel">Teléfono <span class="required">*</span></label>
                <input type="tel" class="form-control" name="TelefonoCel" id="TelefonoCel" value="@Model.TelefonoCel" placeholder="10 dígitos, ej: 5512345678">
            </div>
            <div class="col-md-3">
                <label class="form-label" for="Email">Correo Electrónico <span class="required">*</span></label>
                <input type="email" class="form-control" name="Email" id="Email" value="@Model.Email" placeholder="Ingrese el correo">
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-12">
                <label class="form-label" for="Comentarios">Comentarios</label>
                <textarea class="form-control" name="Comentarios" id="Comentarios" rows="3" placeholder="Observaciones del paciente...">@Model.Comentarios</textarea>
            </div>
        </div>

        <div class="row g-3 mt-3">
            <div class="col-12 text-end">
                <a href="@Url.Action("Index", "Paciente")" class="btn btn-secondary"><i class="fas fa-times me-1"></i> Cancelar</a>
                <input type="button" value="Guardar Paciente" class="btn btn-primary" onclick="guardarPaciente()" />
            </div>
        </div>
    </form>
</div>

@section scripts {
    <script>
        var guardarUrl = '@Url.Action("GuardarOActualizarPaciente", "Paciente")';
        var indexUrl = '@Url.Action("Index", "Paciente")';

        $(document).ready(function () {
            $.validator.addMethod("telefono10", function (value, element) {
                return this.optional(element) || /^\d{10}$/.test(value);
            }, "El teléfono debe tener exactamente 10 dígitos.");

            $('#pacienteForm').validate({
                rules: {
                    Nombre: { required: true },
                    ApellidoPaterno: { required: true },
                    Sexo: { required: true },
                    TelefonoCel: { required: true, telefono10: true },
                    Email: { email: true }
                },
                messages: {
                    Nombre: { required: "El nombre es requerido." },
                    ApellidoPaterno: { required: "El apellido paterno es requerido." },
                    Sexo: { required: "Seleccione el sexo." },
                    TelefonoCel: {
                        required: "El teléfono es requerido.",
                        telefono10: "El teléfono debe tener exactamente 10 dígitos."
                    },
                    Email: {
                        required: "El correo es requerido.",
                        email: "Ingrese un formato de correo válido."
                    }
                },
                errorElement: 'div',
                errorClass: 'invalid-feedback',
                highlight: function (element) { $(element).addClass('is-invalid'); },
                unhighlight: function (element) { $(element).removeClass('is-invalid'); }
            });
        });

        function guardarPaciente() {
            // Validar: si no cumple, salir del método
            if (!$('#pacienteForm').valid()) {
                return;
            }

            // Si cumple, continuar con el proceso
            $.ajax({
                url: guardarUrl,
                type: 'POST',
                data: $('#pacienteForm').serialize(),
                dataType: 'json',
                success: function (response) {
                    var result = (typeof response === 'string') ? JSON.parse(response) : response;
                    if (result.IsSuccess) {
                        Swal.fire({
                            title: '¡Paciente guardado!',
                            text: result.Message || 'El paciente se guardó correctamente.',
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false,
                            confirmButtonColor: '#0099CC'
                        }).then(function () {
                            window.location.href = indexUrl;
                        });
                    } else {
                        Swal.fire({ title: 'Error', text: result.Message || 'No fue posible guardar el paciente.', icon: 'error', confirmButtonColor: '#0099CC' });
                    }
                },
                error: function () {
                    Swal.fire({ title: 'Error', text: 'Error de conexión. Intente nuevamente.', icon: 'error', confirmButtonColor: '#0099CC' });
                }
            });
        }
    </script>
}
