@{
    ViewBag.Title = "Paquetes";
}
<h2 class="page-title"><i class="fas fa-box me-2" style="color: var(--primary);"></i>Paquetes</h2>

<div class="card-custom">
    <div class="card-title" style="display: flex; justify-content: space-between; align-items: center;">
        <span><i class="fas fa-box"></i> Lista de Paquetes</span>
        <a href="@Url.Action("Nuevo", "Paquete")" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> Nuevo Paquete</a>
    </div>

    <div class="table-container">
        <table id="paquetesTable" class="table table-hover table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Costo</th>
                    <th>Estatus</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var editUrl = '@Url.Action("Nuevo", "Paquete")';
            var listUrl = '@Url.Action("ConsultarTodosPaquetes", "Paquete")';

            $('#paquetesTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                pageLength: 10,
                responsive: true,
                columns: [
                    { data: 'Id' },
                    { data: 'Nombre' },
                    { data: 'Descripcion' },
                    { data: 'Costo' },
                    {
                        data: 'Estatus',
                        render: function (data) {
                            return data
                                ? '<span class="badge-status badge-active">Activo</span>'
                                : '<span class="badge-status badge-inactive">Inactivo</span>';
                        }
                    },
                    {
                        data: 'Id',
                        orderable: false,
                        render: function (data) {
                            return '<a href="' + editUrl + '/' + data + '" class="btn btn-sm btn-warning" title="Editar"><i class="fas fa-edit"></i></a>';
                        }
                    }
                ],
                ajax: {
                    url: listUrl,
                    dataSrc: function (json) {
                        var result = (typeof json === 'string') ? JSON.parse(json) : json;
                        return result.IsSuccess ? result.Response : [];
                    }
                }
            });
        });
    </script>
}
