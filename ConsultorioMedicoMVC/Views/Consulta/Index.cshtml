@{
    ViewBag.Title = "Consultas";
}
<h2 class="page-title"><i class="fas fa-stethoscope me-2" style="color: var(--primary);"></i>Consultas</h2>

<div class="card-custom">
    <div class="card-title" style="display: flex; justify-content: space-between; align-items: center;">
        <span><i class="fas fa-stethoscope"></i> Lista de Consultas</span>
        <a href="@Url.Action("Nuevo", "Consulta")" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i> Nueva Consulta</a>
    </div>

    <div class="table-container">
        <table id="consultasTable" class="table table-hover table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Paciente</th>
                    <th>Tipo de Consulta</th>
                    <th>Fecha</th>
                    <th>Estatus</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var editUrl = '@Url.Action("Nuevo", "Consulta")';
            var listUrl = '@Url.Action("ConsultarTodasConsultas", "Consulta")';

            $('#consultasTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                pageLength: 10,
                responsive: true,
                columns: [
                    { data: 'Id' },
                    { data: 'PacienteNombre' },
                    { data: 'TipoConsultaNombre' },
                    { data: 'FechaConsulta' },
                    {
                        data: 'Estatus',
                        render: function (data) {
                            return data
                                ? '<span class="badge-status badge-active">Activa</span>'
                                : '<span class="badge-status badge-inactive">Inactiva</span>';
                        }
                    },
                    {
                        data: 'Id',
                        orderable: false,
                        render: function (data) {
                            return '<a href="' + editUrl + '/' + data + '" class="btn btn-sm btn-warning" title="Editar"><i class="fas fa-edit"></i></a> ' +
                                   '<a href="@Url.Action("Receta", "Consulta")/' + data + '" class="btn btn-sm btn-primary" title="Receta"><i class="fas fa-prescription"></i></a>';
                        }
                    }
                ],
                ajax: {
                    url: listUrl,
                    dataSrc: function (json) {
                        var result = (typeof json === 'string') ? JSON.parse(json) : json;
                        return result.IsSuccess ? result.Response : [];
                    }
                }
            });
        });
    </script>
}
