@model ConsultorioMedicoEntities.Catalogos.Paciente
@{
    ViewBag.Title = "Expediente Clínico";
}
<h2 class="page-title">
    <i class="fas fa-folder-open me-2" style="color: var(--primary);"></i>Expediente Clínico
    <span class="float-end">
        <button type="button" class="btn btn-primary btn-sm me-1" onclick="nuevaCitaExpediente()">
            <i class="fas fa-calendar-plus me-1"></i>Nuevo Tratamiento
        </button>
        <button type="button" class="btn btn-primary btn-sm me-1" onclick="nuevaConsultaExpediente()">
            <i class="fas fa-stethoscope me-1"></i>Nueva Consulta
        </button>
        <a href="@Url.Action("Index", "Paciente")" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Volver a Pacientes
        </a>
    </span>
</h2>

<ul class="nav nav-tabs" id="expedienteTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-info-tab" data-bs-toggle="tab" data-bs-target="#tab-info" type="button" role="tab" aria-controls="tab-info" aria-selected="true">
            <i class="fas fa-user me-1"></i>Información del paciente
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-consultas-tab" data-bs-toggle="tab" data-bs-target="#tab-consultas" type="button" role="tab" aria-controls="tab-consultas" aria-selected="false">
            <i class="fas fa-stethoscope me-1"></i>Historial de consultas
        </button>
    </li>
    <li class="nav-item d-none" role="presentation">
        <button class="nav-link" id="tab-archivos-tab" data-bs-toggle="tab" data-bs-target="#tab-archivos" type="button" role="tab" aria-controls="tab-archivos" aria-selected="false">
            <i class="fas fa-paperclip me-1"></i>Archivos
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-paquetes-tab" data-bs-toggle="tab" data-bs-target="#tab-paquetes" type="button" role="tab" aria-controls="tab-paquetes" aria-selected="false">
            <i class="fas fa-box me-1"></i>Paquetes
        </button>
    </li>
</ul>

<div class="tab-content" id="expedienteTabsContent">
    <div class="tab-pane fade show active" id="tab-info" role="tabpanel" aria-labelledby="tab-info-tab">
        <div class="card-custom">
            <div class="card-title"><i class="fas fa-id-card"></i> Datos del Paciente</div>
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="fw-bold">Nombre Completo</label>
                        <div>@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="fw-bold">Correo</label>
                        <div>@Model.Email</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="fw-bold">Teléfono</label>
                        <div>@Model.TelefonoCel</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="fw-bold">Sexo</label>
                        <div>@Model.Sexo</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="fw-bold">Edad</label>
                        <div>@Model.Edad</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="fw-bold">Fecha de Nacimiento</label>
                        <div>@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-custom">
            <div class="card-title"><i class="fas fa-pills"></i> Tratamientos Históricos</div>
            <div class="table-container">
                <table id="tratamientosTable" class="table table-hover table-striped" style="width:100%">
                    <thead><tr><th>Fecha</th><th>Tratamiento</th><th>Origen</th><th>Comentarios</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-consultas" role="tabpanel" aria-labelledby="tab-consultas-tab">
        <div class="card-custom">
            <div class="card-title"><i class="fas fa-stethoscope"></i> Consultas</div>
            <div class="table-container">
                <table id="consultasTable" class="table table-hover table-striped" style="width:100%">
                    <thead><tr><th>ID</th><th>Fecha</th><th>Tipo</th><th>Descripción</th><th>Acciones</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tab-archivos" role="tabpanel" aria-labelledby="tab-archivos-tab"></div>
    <div class="tab-pane fade" id="tab-paquetes" role="tabpanel" aria-labelledby="tab-paquetes-tab">
        <div class="row">
            <div class="col-md-4">
                <div class="card-custom">
                    <div class="card-title"><i class="fas fa-box"></i> Paquetes adquiridos</div>
                    <div class="table-container">
                        <table id="paquetesTable" class="table table-hover table-striped" style="width:100%">
                            <thead><tr><th>ID</th><th>Paquete</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card-custom">
                    <div class="card-title"><i class="fas fa-calendar-check"></i> Citas del paquete</div>
                    <div class="table-container">
                        <table id="citasPaqueteTable" class="table table-hover table-striped" style="width:100%">
                            <thead><tr><th>ID</th><th>Fecha</th><th>Tratamiento</th><th>Comentarios</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cita (Nuevo Tratamiento) -->
<div class="modal fade" id="modalCitaExpediente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo Tratamiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="citaFormExpediente" autocomplete="off" novalidate>
                    <input type="hidden" name="Id" value="0" />
                    <input type="hidden" name="Estatus" value="true" />
                    <input type="hidden" name="PacienteID" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Paciente</label>
                            <div class="form-control-plaintext fw-bold">@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tratamiento</label>
                            <select class="form-select" name="TratamientoID">
                                <option value="">Seleccione...</option>
                                @foreach (var t in (List<ConsultorioMedicoEntities.Catalogos.Tratamiento>)ViewBag.Tratamientos)
                                {
                                    <option value="@t.Id">@t.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label">Fecha y Hora <span class="required">*</span></label>
                            <input type="datetime-local" class="form-control" name="FechaCita">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estado</label>
                            <select class="form-select" name="Estado">
                                <option value="">Seleccione...</option>
                                <option value="1">Pendiente</option>
                                <option value="2">Confirmada</option>
                                <option value="3">Cancelada</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-12">
                            <label class="form-label">Comentarios</label>
                            <textarea class="form-control" name="Comentarios" rows="4" placeholder="Comentarios de la cita"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <input type="button" value="Guardar" class="btn btn-primary" onclick="guardarCitaExpediente()" />
            </div>
        </div>
    </div>
</div>

<!-- Modal Consulta -->
<div class="modal fade" id="modalConsultaExpediente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nueva Consulta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="consultaFormExpediente" autocomplete="off" novalidate>
                    <input type="hidden" name="Id" value="0" />
                    <input type="hidden" name="Estatus" value="true" />
                    <input type="hidden" name="PacienteID" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Paciente</label>
                            <div class="form-control-plaintext fw-bold">@Model.Nombre @Model.ApellidoPaterno @Model.ApellidoMaterno</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tipo de Consulta</label>
                            <select class="form-select" name="TipoConsultaID">
                                <option value="">Seleccione...</option>
                                @foreach (var t in (List<ConsultorioMedicoEntities.Catalogos.TipoConsulta>)ViewBag.TiposConsulta)
                                {
                                    <option value="@t.Id">@t.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tratamiento</label>
                            <select class="form-select" name="TratamientoID">
                                <option value="">Seleccione...</option>
                                @foreach (var t in (List<ConsultorioMedicoEntities.Catalogos.Tratamiento>)ViewBag.Tratamientos)
                                {
                                    <option value="@t.Id">@t.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label">Fecha y Hora <span class="required">*</span></label>
                            <input type="datetime-local" class="form-control" name="FechaConsulta">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Próxima Consulta</label>
                            <input type="datetime-local" class="form-control" name="FechaProximaConsulta">
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-12">
                            <label class="form-label">Comentarios</label>
                            <textarea class="form-control" name="Comentarios" rows="4" placeholder="Comentarios de la consulta..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <input type="button" value="Guardar" class="btn btn-primary" onclick="guardarConsultaExpediente()" />
            </div>
        </div>
    </div>
</div>

@Html.Partial("_AnexosModal")
@Html.Partial("_RecetaModal")

@section scripts {
    <script src="@Url.Content("~/Scripts/anexos.js")"></script>
    <script>
        var tratamientosTable, consultasTable, paquetesTable, citasPaqueteTable;
        var pacientePaqueteIdActual = 0;

        function pad2(n) { return n < 10 ? '0' + n : n; }

        function formatFechaHoraAmPm(iso) {
            if (!iso) return '';
            var d;
            if (typeof iso === 'string' && iso.indexOf('/Date(') === 0) {
                d = new Date(parseInt(iso.substr(6), 10));
            } else {
                d = new Date(iso);
            }
            if (isNaN(d.getTime())) return '';
            var hh = d.getHours();
            var ampm = hh >= 12 ? 'pm' : 'am';
            var h12 = hh % 12; if (h12 === 0) h12 = 12;
            return pad2(d.getDate()) + '/' + pad2(d.getMonth() + 1) + '/' + d.getFullYear()
                 + ' ' + pad2(h12) + ':' + pad2(d.getMinutes()) + ' ' + ampm;
        }

        function seleccionarPaquete(pacientePaqueteId) {
            if (!pacientePaqueteId) return;
            pacientePaqueteIdActual = pacientePaqueteId;
            if (citasPaqueteTable) {
                citasPaqueteTable.ajax.reload();
            }
        }

        $(document).ready(function () {
            var pacienteId = @Model.Id;
            var recetaUrl = '@Url.Action("Receta", "Consulta")';

            tratamientosTable = $('#tratamientosTable').DataTable({
                language: { url: '@Url.Content("~/Content/datatables-es-ES.json")' },
                pageLength: 5,
                searching: false,
                lengthChange: false,
                columns: [
                    { data: 'Fecha', render: function (data) { return formatFechaHoraAmPm(data); } },
                    { data: 'TratamientoNombre' },
                    { data: 'Origen' },
                    { data: 'Comentarios' }
                ],
                ajax: {
                    url: '@Url.Action("ConsultarTratamientosPorPaciente", "Historial")',
                    data: function (d) { d.pacienteId = pacienteId; return d; },
                    dataSrc: function (json) { var r = (typeof json === 'string') ? JSON.parse(json) : json; return r.IsSuccess ? r.Response : []; }
                }
            });

            consultasTable = $('#consultasTable').DataTable({
                language: { url: '@Url.Content("~/Content/datatables-es-ES.json")' },
                pageLength: 5,
                searching: false,
                lengthChange: false,
                columns: [
                    { data: 'Id', visible: false },
                    { data: 'FechaConsulta', render: function (data) { return formatFechaHoraAmPm(data); } },
                    { data: 'TipoConsultaNombre' },
                    { data: 'Descripcion' },
                    {
                        data: 'Id',
                        orderable: false,
                        render: function (data) {
                            return '<button type="button" class="btn btn-sm btn-secondary btn-anexos-consulta" data-id="' + data + '" title="Anexos"><i class="fas fa-paperclip"></i></button>';
                        }
                    }
                ],
                ajax: {
                    url: '@Url.Action("ConsultarConsultasPorPaciente", "Historial")',
                    data: function (d) { d.pacienteId = pacienteId; return d; },
                    dataSrc: function (json) { var r = (typeof json === 'string') ? JSON.parse(json) : json; return r.IsSuccess ? r.Response : []; }
                }
            });

            consultasTable.on('dblclick', 'tbody tr', function () {
                var data = consultasTable.row(this).data();
                abrirModalReceta(data.Id);
            });

            consultasTable.on('click', '.btn-anexos-consulta', function (e) {
                e.stopPropagation();
                var id = $(this).data('id');
                abrirModalAnexos(pacienteId, '', id);
            });

            consultasTable.on('dblclick', '.btn-anexos-consulta', function (e) {
                e.stopPropagation();
            });

            paquetesTable = $('#paquetesTable').DataTable({
                language: { url: '@Url.Content("~/Content/datatables-es-ES.json")' },
                pageLength: 5,
                searching: false,
                lengthChange: false,
                columns: [
                    { data: 'Id', visible: false },
                    { data: 'PaqueteNombre' }
                ],
                ajax: {
                    url: '@Url.Action("ConsultarPaquetesPorPaciente", "Historial")',
                    data: function (d) { d.pacienteId = pacienteId; return d; },
                    dataSrc: function (json) { var r = (typeof json === 'string') ? JSON.parse(json) : json; return r.IsSuccess ? r.Response : []; }
                },
                initComplete: function () {
                    var api = this.api();
                    if (api.rows().count() > 0) {
                        seleccionarPaquete(api.row(0).data().Id);
                        $(api.row(0).node()).addClass('table-active');
                    }
                }
            });

            citasPaqueteTable = $('#citasPaqueteTable').DataTable({
                language: { url: '@Url.Content("~/Content/datatables-es-ES.json")' },
                pageLength: 5,
                searching: false,
                lengthChange: false,
                columns: [
                    { data: 'Id', visible: false },
                    { data: 'FechaCita', render: function (data) { return formatFechaHoraAmPm(data); } },
                    { data: 'TratamientoNombre' },
                    { data: 'Comentarios' }
                ],
                ajax: {
                    url: '@Url.Action("ConsultarCitasPorPacientePaquete", "Historial")',
                    data: function (d) { d.pacientePaqueteId = pacientePaqueteIdActual; return d; },
                    dataSrc: function (json) { var r = (typeof json === 'string') ? JSON.parse(json) : json; return r.IsSuccess ? r.Response : []; }
                }
            });

            paquetesTable.on('click', 'tbody tr', function () {
                var data = paquetesTable.row(this).data();
                $('#paquetesTable tbody tr').removeClass('table-active');
                $(this).addClass('table-active');
                seleccionarPaquete(data.Id);
            });

            $('#citaFormExpediente').validate({
                rules: { FechaCita: { required: true } },
                messages: { FechaCita: { required: "La fecha de la cita es requerida." } },
                errorElement: 'div',
                errorClass: 'invalid-feedback',
                highlight: function (e) { $(e).addClass('is-invalid'); },
                unhighlight: function (e) { $(e).removeClass('is-invalid'); }
            });

            $('#consultaFormExpediente').validate({
                rules: { FechaConsulta: { required: true } },
                messages: { FechaConsulta: { required: "La fecha de la consulta es requerida." } },
                errorElement: 'div',
                errorClass: 'invalid-feedback',
                highlight: function (e) { $(e).addClass('is-invalid'); },
                unhighlight: function (e) { $(e).removeClass('is-invalid'); }
            });

            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function () {
                $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
            });

            $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
        });

        function nuevaCitaExpediente() {
            $('#citaFormExpediente')[0].reset();
            $('#modalCitaExpediente').modal('show');
        }

        function guardarCitaExpediente() {
            if (!$('#citaFormExpediente').valid()) return;
            $.ajax({
                url: '@Url.Action("GuardarOActualizarCita", "Cita")',
                type: 'POST',
                data: $('#citaFormExpediente').serialize(),
                dataType: 'json',
                success: function (response) {
                    var r = (typeof response === 'string') ? JSON.parse(response) : response;
                    if (r.IsSuccess) {
                        Swal.fire({ title: '¡Tratamiento guardado!', icon: 'success', timer: 1500, showConfirmButton: false }).then(function () {
                            $('#modalCitaExpediente').modal('hide');
                            tratamientosTable.ajax.reload();
                        });
                    } else {
                        Swal.fire({ title: 'Error', text: r.Message || 'No fue posible guardar la cita.', icon: 'error', confirmButtonColor: '#0099CC' });
                    }
                },
                error: function () {
                    Swal.fire({ title: 'Error', text: 'Error de conexión. Intente nuevamente.', icon: 'error', confirmButtonColor: '#0099CC' });
                }
            });
        }

        function nuevaConsultaExpediente() {
            $('#consultaFormExpediente')[0].reset();
            $('#modalConsultaExpediente').modal('show');
        }

        function guardarConsultaExpediente() {
            if (!$('#consultaFormExpediente').valid()) return;
            $.ajax({
                url: '@Url.Action("GuardarOActualizarConsulta", "Consulta")',
                type: 'POST',
                data: $('#consultaFormExpediente').serialize(),
                dataType: 'json',
                success: function (response) {
                    var r = (typeof response === 'string') ? JSON.parse(response) : response;
                    if (r.IsSuccess) {
                        Swal.fire({ title: '¡Consulta guardada!', icon: 'success', timer: 1500, showConfirmButton: false }).then(function () {
                            $('#modalConsultaExpediente').modal('hide');
                            consultasTable.ajax.reload();
                        });
                    } else {
                        Swal.fire({ title: 'Error', text: r.Message || 'No fue posible guardar la consulta.', icon: 'error', confirmButtonColor: '#0099CC' });
                    }
                },
                error: function () {
                    Swal.fire({ title: 'Error', text: 'Error de conexión. Intente nuevamente.', icon: 'error', confirmButtonColor: '#0099CC' });
                }
            });
        }
    </script>
}
