@{
    ViewBag.Title = "Historial del Paciente";
}
<h2 class="page-title"><i class="fas fa-history me-2" style="color: var(--primary);"></i>Historial del Paciente</h2>

<div class="card-custom">
    <div class="card-title"><i class="fas fa-user-injured"></i> Seleccione un Paciente</div>
    <div class="row">
        <div class="col-md-4">
            <select id="filtroPaciente" class="form-select">
                <option value="">Seleccione...</option>
                @foreach (var p in (List<ConsultorioMedicoEntities.Catalogos.PacienteDTO>)ViewBag.Pacientes)
                {
                    <option value="@p.Id">@p.NombreCompleto</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="card-custom">
    <div class="card-title"><i class="fas fa-calendar-check"></i> Citas</div>
    <div class="table-container">
        <table id="citasTable" class="table table-hover table-striped">
            <thead><tr><th>ID</th><th>Fecha</th><th>Tratamiento</th><th>Comentarios</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="card-custom">
    <div class="card-title"><i class="fas fa-stethoscope"></i> Consultas</div>
    <div class="table-container">
        <table id="consultasTable" class="table table-hover table-striped">
            <thead><tr><th>ID</th><th>Fecha</th><th>Tipo</th><th>Descripción</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="card-custom">
    <div class="card-title"><i class="fas fa-paperclip"></i> Anexos</div>
    <div class="table-container">
        <table id="anexosTable" class="table table-hover table-striped">
            <thead><tr><th>ID</th><th>Nombre</th><th>Fecha</th><th>Comentarios</th><th>Acciones</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            var citasTable = $('#citasTable').DataTable({
                language: { url: '@Url.Content("~/Content/datatables-es-ES.json")' },
                pageLength: 5,
                responsive: true,
                columns: [
                    { data: 'Id' },
                    { data: 'FechaCita' },
                    { data: 'TratamientoNombre' },
                    { data: 'Comentarios' }
                ],
                ajax: {
                    url: '@Url.Action("ConsultarCitasPorPaciente", "Historial")',
                    data: function (d) { d.pacienteId = $('#filtroPaciente').val() || 0; return d; },
                    dataSrc: function (json) { var r = (typeof json === 'string') ? JSON.parse(json) : json; return r.IsSuccess ? r.Response : []; }
                }
            });

            var consultasTable = $('#consultasTable').DataTable({
                language: { url: '@Url.Content("~/Content/datatables-es-ES.json")' },
                pageLength: 5,
                responsive: true,
                columns: [
                    { data: 'Id' },
                    { data: 'FechaConsulta' },
                    { data: 'TipoConsultaNombre' },
                    { data: 'Descripcion' }
                ],
                ajax: {
                    url: '@Url.Action("ConsultarConsultasPorPaciente", "Historial")',
                    data: function (d) { d.pacienteId = $('#filtroPaciente').val() || 0; return d; },
                    dataSrc: function (json) { var r = (typeof json === 'string') ? JSON.parse(json) : json; return r.IsSuccess ? r.Response : []; }
                }
            });

            var anexosTable = $('#anexosTable').DataTable({
                language: { url: '@Url.Content("~/Content/datatables-es-ES.json")' },
                pageLength: 5,
                responsive: true,
                columns: [
                    { data: 'Id' },
                    { data: 'Nombre' },
                    { data: 'Fecha' },
                    { data: 'Comentarios' },
                    {
                        data: 'Id',
                        orderable: false,
                        render: function (data) {
                            return '<a href="@Url.Action("Descargar", "Anexo")/' + data + '" class="btn btn-sm btn-primary" title="Descargar"><i class="fas fa-download"></i></a>';
                        }
                    }
                ],
                ajax: {
                    url: '@Url.Action("ConsultarAnexosPorPaciente", "Historial")',
                    data: function (d) { d.pacienteId = $('#filtroPaciente').val() || 0; return d; },
                    dataSrc: function (json) { var r = (typeof json === 'string') ? JSON.parse(json) : json; return r.IsSuccess ? r.Response : []; }
                }
            });

            $('#filtroPaciente').on('change', function () {
                citasTable.ajax.reload();
                consultasTable.ajax.reload();
                anexosTable.ajax.reload();
            });
        });
    </script>
}
